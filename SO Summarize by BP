WITH
MY_BP AS (
    SELECT PARTNER
    FROM BUT000
    WHERE NAME_ORG1 LIKE 'KUBOTA ENGINE%SHANGHAI%'
    AND CLIENT= XXX
),
MY_SO AS (
    SELECT v.VBELN,v.KUNNR
    FROM VBAK v
    JOIN MY_BP bp 
    ON v.KUNNR = bp.PARTNER
    WHERE v.MANDT= XXX
)
SELECT
    so.KUNNR AS PARNTER,
    SUM(p.KWMENG) AS QUANTITY,
    SUM(p.NETWR) AS AMOUNT,
    p.WAERK AS CURRENCY
FROM VBAP p
JOIN MY_SO so ON p.VBELN = so.VBELN
WHERE p.MANDT= XXX
AND p.FKREL='H'
GROUP BY p.WAERK, so.KUNNR
;
